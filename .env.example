# Copy to .env.local.

# ---------------------------------------------------------------------------
# RECOMMENDED: needed main expereience
# ---------------------------------------------------------------------------

OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL: integrations (each works on its own; leave empty to skip)
# ---------------------------------------------------------------------------

# Real email to vendors. Set RESEND_API_KEY or SMTP_URL.
RESEND_API_KEY=
# e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Sends every vendor email to one inbox (demo).
VENDOR_EMAIL=
# Mailbox the Vendor Liaison reads replies from. Defaults to the Gmail account in SMTP_URL.
IMAP_URL=
INBOX_POLL_MS=30000

# Real Slack messages. Set SLACK_BOT_TOKEN or SLACK_WEBHOOK_URL.
# Bot token scopes: chat:write, chat:write.public, channels:read, channels:manage, channels:join.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
# One member id (U0123) or a map {"priya":"U0123"}
SLACK_USER_IDS=
# Base URL used in links inside Slack and email.
APP_URL=http://localhost:3000

# External billing feed: GET <url>?after=<cursor> -> { events: BillingEvent[], next_cursor }
BILLING_FEED_URL=

# ---------------------------------------------------------------------------
# OPTIONAL: tuning (defaults are fine)
# ---------------------------------------------------------------------------

# Model id; empty uses the built-in default.
OPENAI_MODEL=
# llm | deterministic. Empty picks llm when a key is set.
AGENT_MODE=
# 1 stops the SDK exporting traces to OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=1

# SQLite file. Defaults to ./data/moa.db (an existing ./data/experiment-ledger.db is kept and used).
DATABASE_PATH=

# How often the scheduler syncs billing feeds and runs follow-ups. AUTONOMY=off disables it.
SCHEDULER_INTERVAL_MS=5000
AUTONOMY=

# Pause between deterministic agent steps so the live timeline is watchable.
DETERMINISTIC_STEP_DELAY_MS=700

# The controller's display name. A public demo uses "You" unless set.
CONTROLLER_NAME=

# Simulated vendor, used when no email transport is set (always on a public demo).
# on | off to force it.
MOCK_VENDOR=
# First reply's stance: credit | partial | evidence | random (default). Later replies settle in full.
MOCK_VENDOR_OUTCOME=
MOCK_VENDOR_DELAY_MS=6000
