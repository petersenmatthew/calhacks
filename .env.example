# All optional. Copy to .env.local.

# LLM agents through the OpenAI Agents SDK. Without a key the agents run in deterministic replay.
OPENAI_API_KEY=
OPENAI_MODEL=
# llm | deterministic
AGENT_MODE=
# Factory Droid runs the six employees when this is set (needs the droid CLI on PATH).
# The assistant and the simulated vendor still use OPENAI_API_KEY.
FACTORY_API_KEY=
# Droid model id; empty uses the Droid default. AGENT_ENGINE=openai keeps the employees on the OpenAI Agents SDK.
DROID_MODEL=
AGENT_ENGINE=
# Set to 1 to stop the SDK exporting traces to OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=1

# SQLite file. Defaults to ./data/moa.db (an existing ./data/experiment-ledger.db is kept and used).
DATABASE_PATH=

# Autonomy scheduler: how often it syncs billing feeds and runs follow-ups. AUTONOMY=off disables it.
SCHEDULER_INTERVAL_MS=5000
AUTONOMY=
# Optional external billing feed: GET <url>?after=<cursor> -> { events: BillingEvent[], next_cursor }
BILLING_FEED_URL=

# Pause between deterministic agent steps so the live timeline is watchable.
DETERMINISTIC_STEP_DELAY_MS=700

# Email to vendors. VENDOR_EMAIL sends every vendor email to one inbox (demo).
VENDOR_EMAIL=
RESEND_API_KEY=
# Or SMTP, e.g. smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Vendor replies are read from this mailbox and handed to the Vendor Liaison.
# Defaults to the Gmail account in SMTP_URL (imap.gmail.com, same app password).
IMAP_URL=
INBOX_POLL_MS=30000

# Slack. Bot token needs scopes chat:write, chat:write.public, channels:read, channels:manage, channels:join. SLACK_USER_IDS: one member id (U0123) or a map {"priya":"U0123"}
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_USER_IDS=
APP_URL=http://localhost:3000

# Public deployment for judges (Fly.io): intro screen, Slack/email recorded only, rate limits, capped model runs.
PUBLIC_DEMO=
MAX_LLM_RUNS_PER_HOUR=120

# The controller's display name (the person using the app). A public demo uses "You" unless this is set.
CONTROLLER_NAME=

# Simulated vendor: when no email transport is set (always on a public demo), a model playing the
# provider's billing team answers disputes a few seconds after they are sent. on | off to force it.
MOCK_VENDOR=
# First reply's stance: credit | partial | evidence | random (default). Later replies settle in full.
MOCK_VENDOR_OUTCOME=
MOCK_VENDOR_DELAY_MS=6000
