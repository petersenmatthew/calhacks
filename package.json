{
  "name": "moa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --import tsx scripts/eval.ts",
    "eval:live": "AGENT_MODE=llm node --env-file=.env.local --import tsx scripts/eval.ts --case=O-01,E-01",
    "contracts:pdf": "python3 scripts/contracts/build_contract_pdfs.py",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@factory/droid-sdk": "^0.10.0",
    "@openai/agents": "^0.21.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.8.2",
    "imapflow": "^1.7.8",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.12.4",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Autonomous finance operations for AI research labs: GPU cost reconciliation with Compute and Finance agents.",
  "engines": {
    "node": ">=22"
  }
}
